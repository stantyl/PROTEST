<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>

  <log4net>
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%-5level; %date{ISO8601}; [%thread]; %logger; %method; %message%newline" />
      </layout>
    </appender>

    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="Logs\CoolingOffEmailRunnerCloasProxyConsoleTest.log" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value=".yyyy-MM-dd" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%-5level; %date{ISO8601}; [%thread]; %logger; %method; %message%newline" />
      </layout>
    </appender>

    <root>
      <level value="DEBUG" />
      <appender-ref ref="ConsoleAppender" />
      <appender-ref ref="RollingFileAppender" />
    </root>
  </log4net>

  <appSettings>
    <!--
      URL of the CloasProxy IIS app under test - its own /CloasService.svc,
      NOT the real CLOAS endpoint. Point this at the proxy instance you want
      to validate (e.g. http://localhost/CoolingOffEmailRunnerCloasProxy/CloasService.svc
      for a local IIS deployment, or the UAT2/PROD proxy host).
    -->
    <add key="CloasProxy.ServiceUrl" value="http://localhost/CoolingOffEmailRunnerCloasProxy/CloasService.svc" />
    <add key="CloasProxy.TimeoutSeconds" value="60" />

    <!--
      SOAP envelope placeholder values - the same set CoolingOffEmailRunnerConsole's
      CloasService:* appsettings.json section feeds into
      BuildSoapEnvelopeWithPlans, so the request built here is representative of
      what the real console app sends through the proxy. The envelope template
      itself is an embedded constant in Program.cs (no template file).
    -->
    <add key="Cloas.SystemId" value="AZC" />
    <add key="Cloas.UserId" value="123" />
    <add key="Cloas.SystemReference" value="CCOE" />
    <add key="Cloas.SoapAction" value="http://ilfs/Cloas/Policy" />
    <add key="Cloas.CloasNamespace" value="http://ilfs/Cloas" />
    <add key="Cloas.CloasPolicyApiNamespace" value="http://ilfs/Cloas/PolicyApi" />
    <add key="Cloas.XsiNamespace" value="http://www.w3.org/2001/XMLSchema-instance" />
    <add key="Cloas.MethodName" value="RetrieveCoolingOffDtlsByPlan" />

    <!--
      Test data: comma-separated plan IDs to send through the proxy on each run.
      Replace with real/UAT plan IDs known to exist in the target CLOAS environment.
    -->
    <add key="Cloas.TestPlanIds" value="1000001,1000002,1000003" />
  </appSettings>
</configuration>
