<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Emit the XML doc file so Swagger can surface the controller summaries. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591: don't warn on undocumented public members.
      NU1902: log4net 2.0.x carries a moderate XXE advisory (GHSA-4f7c-pmjv-c25w)
      that only bites when the log4net *config* is loaded from an untrusted
      source - here it is a trusted local file. Pinned to 2.0.15 to stay in
      step with the rest of the CoolingOffEmailRunner solution.
    -->
    <NoWarn>$(NoWarn);CS1591;NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="2.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.22" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
