<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>

  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="Logs\CoolingOffEmailRunnerCloasProxy.log" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value=".yyyy-MM-dd" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%-5level; %date{ISO8601}; [%thread]; %logger; %method; %message%newline" />
      </layout>
    </appender>

    <root>
      <level value="DEBUG" />
      <appender-ref ref="RollingFileAppender" />
    </root>
  </log4net>

  <appSettings>
    <!--
      The real CLOAS service this proxy forwards every request to. This runs on
      a server that DOES have network access to CLOAS; CoolingOffEmailRunnerConsole
      instead calls this proxy's own /CloasService.svc, which is not blocked.

      To point at a different CLOAS endpoint in future, change only this one
      value and recycle the app pool - no rebuild, and no change needed in
      CoolingOffEmailRunnerConsole (it still just points at this proxy's URL).
    -->
    <add key="CloasProxy.TargetServiceUrl" value="http://XXX:8200/UAT02/CloasService.svc" />
    <add key="CloasProxy.TimeoutSeconds" value="300" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.5.2" />
    <httpRuntime targetFramework="4.5.2" maxRequestLength="51200" executionTimeout="330" />
  </system.web>

  <system.serviceModel>
    <bindings>
      <!--
        A customBinding, not webHttpBinding, so webMessageEncoding can point at
        RawContentTypeMapper - without it webHttpBinding maps an incoming
        Content-Type of text/xml to the Xml body format and rejects the raw
        Process(Stream) call ("unrecognized http body format value 'Xml'. The
        expected format value is 'Raw'"). These elements are the customBinding
        equivalent of the previous webHttpBinding (webMessageEncoding +
        httpTransport with manualAddressing="true").

        If this proxy is ever hosted over HTTPS, swap <httpTransport> for
        <httpsTransport> with the same attributes.
      -->
      <customBinding>
        <binding name="cloasProxyBinding"
                 sendTimeout="00:05:30"
                 receiveTimeout="00:05:30"
                 openTimeout="00:01:00"
                 closeTimeout="00:01:00">
          <webMessageEncoding webContentTypeMapperType="CoolingOffEmailRunnerCloasProxy.RawContentTypeMapper, CoolingOffEmailRunnerCloasProxy">
            <readerQuotas maxDepth="64"
                          maxStringContentLength="52428800"
                          maxArrayLength="52428800"
                          maxBytesPerRead="52428800"
                          maxNameTableCharCount="52428800" />
          </webMessageEncoding>
          <httpTransport manualAddressing="true"
                         maxReceivedMessageSize="52428800"
                         maxBufferSize="52428800"
                         maxBufferPoolSize="52428800"
                         transferMode="Buffered" />
        </binding>
      </customBinding>
    </bindings>

    <behaviors>
      <endpointBehaviors>
        <behavior name="cloasProxyEndpointBehavior">
          <webHttp />
        </behavior>
      </endpointBehaviors>
      <serviceBehaviors>
        <behavior name="cloasProxyServiceBehavior">
          <serviceMetadata httpGetEnabled="false" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>

    <services>
      <service name="CoolingOffEmailRunnerCloasProxy.CloasProxyService" behaviorConfiguration="cloasProxyServiceBehavior">
        <endpoint address=""
                  binding="customBinding"
                  bindingConfiguration="cloasProxyBinding"
                  contract="CoolingOffEmailRunnerCloasProxy.ICloasProxyService"
                  behaviorConfiguration="cloasProxyEndpointBehavior" />
      </service>
    </services>

    <!--
      aspNetCompatibilityEnabled: run the service inside the ASP.NET request
      pipeline so HttpContext.Current is populated. CloasProxyService reads the
      incoming SOAPAction / Content-Type headers from the real HTTP request to
      forward them unchanged; WebOperationContext.Current.IncomingRequest.Headers
      is not reliably populated for the wildcard (Method = "*") raw-stream
      operation. The service is marked [AspNetCompatibilityRequirements(Required)].
    -->
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
  </system.serviceModel>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <!-- Allow the same request-size headroom as system.web/httpRuntime above under the IIS7+ integrated pipeline. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
